/* ═══════════════════════════════════════ */
/*  基础样式 — Reset + 排版 + 卡片        */
/* ═══════════════════════════════════════ */

/* ---- Tabler Icons 3.44.0 (内联字体) ---- */
@font-face {
  font-family: "tabler-icons";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.44.0/dist/fonts/tabler-icons.woff2?v3.44.0") format("woff2"),
       url("https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.44.0/dist/fonts/tabler-icons.woff?") format("woff");
}
.ti {
  font-family: "tabler-icons" !important;
  speak: none;
  font-style: normal;
  font-weight: 400;
  font-variant: normal;
  text-transform: none;
  line-height: 1;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ---- CSS Reset ---- */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html {
  font-size: 16px;
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ---- 无障碍 ---- */
:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 2px;
  border-radius: 4px;
}
:focus:not(:focus-visible) { outline: none; }
.sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.sr-only-focusable:focus {
  position: static;
  width: auto; height: auto;
  padding: 0.5rem 1rem; margin: 0;
  overflow: visible;
  clip: auto;
  white-space: normal;
}

/* 减少动画偏好 */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ---- 水墨山水底层（html 元素 — 比 body 更底层） ---- */
html {
  height: 100%;
  background: url('../img/bg-landscape.webp') center / cover no-repeat fixed;
}

/* ---- 暖黄宣纸基底 —— 半透明叠在山水上方 ---- */
body {
  font-family: var(--font-body);
  background:
    radial-gradient(ellipse at 50% 0%, rgba(253,248,240,0.78) 0%, rgba(245,237,224,0.84) 55%, rgba(235,224,208,0.88) 100%);
  color: var(--text-primary);
  color: var(--text-primary);
  line-height: 1.7;
  min-height: 100vh;
  overflow-x: hidden;
  font-size: 1rem;
  letter-spacing: 0.01em;
  font-kerning: normal;
  font-feature-settings: "kern" 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
}
body.dark {
  background:
    radial-gradient(ellipse at 50% 0%, rgba(26,18,16,0.88) 0%, rgba(13,10,7,0.92) 55%, rgba(8,6,4,0.95) 100%);
}

/* ---- 噪点纹理 ---- */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: 0.03;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size: 200px 200px;
}
body.dark::before { opacity: 0.035; }

/* ---- 主容器：仿古书卷 ---- */
.wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 960px;
  margin: var(--top-nav-height, 120px) auto 3rem;
  padding: 1rem 1.25rem;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-gold);
  box-shadow: var(--shadow-lg), var(--shadow-gold);
  overflow: hidden;
}

/* ---- 触摸反馈 ---- */
button:active, .tab-item:active {
  transform: scale(0.97);
  opacity: 0.85;
  transition: transform 0.1s;
}

/* ---- 卡片系统 ---- */
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-gold);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
  overflow: hidden;
  position: relative;
}
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--color-gold-pale), var(--color-gold), var(--color-gold-pale));
  opacity: 0.6;
}
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.5rem 0.75rem;
  background: linear-gradient(180deg, rgba(201,169,110,0.08), transparent);
  cursor: pointer;
  font-family: var(--font-display);
  font-weight: 600;
  color: var(--text-heading);
  font-size: var(--text-sm);
  user-select: none;
}
.card-header span { display: flex; align-items: center; gap: 0.4rem; }
.card-collapse-icon { transition: transform 0.3s ease; font-size: 0.75rem; }
.card.collapsed .card-collapse-icon { transform: rotate(-90deg); }
.card-body {
  padding: 0.75rem 1rem;
  transition: max-height 0.35s ease, padding 0.35s ease;
  overflow: hidden;
}
.card.collapsed .card-body {
  max-height: 0 !important;
  padding-top: 0;
  padding-bottom: 0;
}

/* ---- 响应式 ---- */
@media (max-width: 768px) {
  .wrap {
    margin-top: var(--top-nav-height, 80px);
    margin-bottom: 1.5rem;
    padding: 0.75rem 0.75rem;
    border-radius: 0;
    border-left: none;
    border-right: none;
  }
}
@media (max-width: 600px) {
  .wrap {
    margin-top: var(--top-nav-height, 80px);
    padding: 0.5rem 0.5rem;
  }
  .bazi-card-body { padding: 0.75rem; }
  .bazi-input { padding: 0.4rem 0.5rem; min-height: 40px; }
}

/* ═══════════════════════════════════════ */
/*  设置面板                              */
/* ═══════════════════════════════════════ */
.settings-panel {
    display: none;
    background: var(--bg-card);
    border: 1px solid var(--border-gold);
    border-radius: var(--radius-md);
    padding: 0.6rem 0.8rem;
    box-shadow: var(--shadow-md);
    position: absolute; top: 100%; right: 0;
    width: 280px; max-width: calc(100vw - 16px);
    z-index: 100;
    margin-top: 4px;
    animation: fadeInDown 0.2s ease;
}
.settings-panel.show { display: block; }
@keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
}
.st-row {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 3rem; padding: 0.35rem 0; gap: 0.6rem;
    border-bottom: 1px solid var(--border-ink);
}
.st-row:last-child { border-bottom: none; }
.st-row > div { display: flex; flex-direction: column; justify-content: center; }
.st-label { display: flex; align-items: center; gap: 0.3rem; font-weight: 600; color: var(--text-primary); line-height: 1.4; }
.st-desc { font-size: 0.6rem; color: var(--text-muted); }
.st-row .font-size-btns { display: flex; flex-direction: row; flex-wrap: nowrap; gap: 4px; }
.fs-btn {
  width: 24px; height: 24px;
  border: 1.5px solid var(--border-gold);
  background: var(--bg-input); color: var(--text-secondary);
  border-radius: 4px; cursor: pointer;
  font-size: 0.65rem; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.15s;
}
.fs-btn:hover { background: var(--border-ink); color: var(--text-primary); }
.fs-btn.fs-active {
  background: var(--color-gold);
  color: #fff;
  border-color: var(--color-gold);
}
.toggle-sw {
    position: relative; display: inline-block; width: 38px; height: 20px; flex-shrink: 0;
}
.toggle-sw input { opacity: 0; width: 0; height: 0; }
.toggle-slider {
    position: absolute; cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: #ccc; transition: 0.25s; border-radius: 20px;
}
.toggle-slider:before {
    position: absolute; content: "";
    height: 14px; width: 14px; left: 3px; bottom: 3px;
    background: #fff; transition: 0.25s; border-radius: 50%;
}
.toggle-sw input:checked + .toggle-slider { background: var(--color-gold); }
.toggle-sw input:checked + .toggle-slider:before { transform: translateX(18px); }
body.dark .settings-panel { background: #1e1c24; border-color: #3d3428; }
body.dark .st-row { border-bottom-color: #2a2520; }
body.dark .toggle-slider { background: #555; }

/* ═══════════════════════════════════════ */
/*  每日记事编辑器                        */
/* ═══════════════════════════════════════ */
.daily-note-dot {
  display: inline-block; width: 7px; height: 7px; border-radius: 50%;
  background: #e8492e; vertical-align: top; margin-left: 1px;
  box-shadow: 0 0 3px rgba(232,73,46,0.4);
}
body.dark .daily-note-dot { background: #ff6b4a; box-shadow: 0 0 4px rgba(255,107,74,0.5); }
.note-editor-overlay {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35); z-index: calc(var(--z-overlay) + 100);
  display: flex; align-items: center; justify-content: center;
  padding: 16px; animation: fadeIn 0.2s ease;
}
.note-editor-card {
  background: var(--bg-card); border: 2px solid var(--border-gold);
  border-radius: var(--radius-md); padding: 1rem;
  width: 100%; max-width: 420px; box-shadow: var(--shadow-lg);
}
.note-editor-title {
  font-family: var(--font-display); font-size: 0.95rem;
  font-weight: 700; color: var(--color-gold-bright);
  text-align: center; margin-bottom: 0.5rem; border-bottom: 1px solid var(--border-gold); padding-bottom: 0.4rem;
}
.note-editor-textarea {
  width: 100%; max-width: 100%; box-sizing: border-box;
  padding: 8px 10px; border: 1.5px solid var(--border-gold);
  border-radius: 6px; background: var(--bg-input); color: var(--text-primary);
  font-size: var(--text-sm); resize: vertical; min-height: 100px; font-family: inherit;
  line-height: 1.6;
}
.note-editor-textarea:focus { border-color: #d4a853; outline: none; box-shadow: 0 0 0 2px rgba(212,168,83,0.2); }
.note-editor-actions {
  display: flex; gap: 8px; margin-top: 10px;
  justify-content: flex-end; align-items: center;
}
.note-editor-actions .note-info { font-size: 0.6rem; color: var(--text-muted); margin-right: auto; }
.note-editor-save, .note-editor-delete, .note-editor-close {
  padding: 5px 14px; border-radius: 10px; cursor: pointer;
  font-family: inherit; font-size: 0.72rem; font-weight: 600;
  border: 1px solid transparent; transition: background 0.15s, border-color 0.15s;
}
.note-editor-save { background: #eaf2dc; color: #4a7a2a; border-color: #c0d8a0; }
.note-editor-save:hover { background: #d8eac0; border-color: #a0c870; }
.note-editor-delete { background: #fff0f0; color: #b5343a; border-color: #e0c0c0; }
.note-editor-delete:hover { background: #ffe8e8; border-color: #d0a0a0; }
.note-editor-close { background: #f5f5f0; color: #8a8a70; border-color: #d8d8c8; }
.note-editor-close:hover { background: #eaead8; color: #6a6a50; }
.note-editor-save:active, .note-editor-delete:active, .note-editor-close:active { transform: scale(0.96); }
body.dark .note-editor-overlay { background: rgba(0,0,0,0.6); }
body.dark .note-editor-card { background: #1a1510; border-color: #4a3a20; }
body.dark .note-editor-textarea { background: #151210; border-color: #4a3a20; color: #d0c8b0; }
body.dark .note-editor-textarea:focus { border-color: #8b7530; box-shadow: 0 0 0 2px rgba(139,117,48,0.25); }
body.dark .note-editor-save { background: #1a2a10; color: #80b050; border-color: #3a4a20; }
body.dark .note-editor-save:hover { background: #203018; border-color: #4a5a28; }
body.dark .note-editor-delete { background: #2a1518; color: #e08080; border-color: #5a3035; }
body.dark .note-editor-delete:hover { background: #301a1e; border-color: #7a4045; }
body.dark .note-editor-close { background: #1c1c18; color: #808068; border-color: #3a3a28; }
body.dark .note-editor-close:hover { background: #252520; color: #a0a080; }

/* ═══════════════════════════════════════ */
/*  命盘档案管理                          */
/* ═══════════════════════════════════════ */
.bazi-archive-overlay {
  display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45); z-index: var(--z-archive-overlay);
  align-items: center; justify-content: center;
}
.bazi-archive-overlay.show { display: flex; }
.bazi-archive-card {
  background: var(--bg-card); border: 2px solid var(--border-gold);
  border-radius: var(--radius-lg); padding: 20px 24px;
  width: 92%; max-width: 520px; max-height: 80vh;
  box-shadow: 0 12px 48px rgba(0,0,0,0.25);
  display: flex; flex-direction: column;
  animation: archiveSlideUp 0.25s ease;
}
@keyframes archiveSlideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
.bazi-archive-header {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 12px; border-bottom: 1.5px solid var(--border-gold);
  margin-bottom: 12px; flex-shrink: 0;
}
.bazi-archive-title {
  font-family: var(--font-display); font-size: 1.05rem;
  font-weight: 700; color: var(--color-gold-bright); letter-spacing: 0.04em;
}
.bazi-archive-close {
  width: 32px; height: 32px; border-radius: 50%;
  background: var(--border-light); border: none; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; color: var(--text-secondary);
  transition: color 0.2s, background 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.bazi-archive-close:hover { background: var(--color-cinnabar); color: #fff; }
.bazi-archive-list { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.bazi-archive-empty {
  text-align: center; color: var(--text-muted); padding: 32px 0;
  font-size: 0.9rem; letter-spacing: 0.04em;
}
.bazi-archive-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 10px 12px; margin: 6px 0;
  background: var(--bg-input); border: 1px solid var(--border-light);
  border-radius: var(--radius-sm); cursor: pointer;
  transition: color 0.15s, background 0.15s, box-shadow 0.15s, border-color 0.15s;
}
.bazi-archive-item:hover { border-color: var(--border-gold); background: var(--bg-card-raised); }
.bazi-archive-item-info { flex: 1; min-width: 0; }
.bazi-archive-item-name {
  font-family: var(--font-display); font-weight: 700; font-size: 0.9rem;
  color: var(--text-primary); letter-spacing: 0.03em;
}
.bazi-archive-item-pillars {
  font-size: 0.75rem; color: var(--text-secondary); margin-top: 2px; letter-spacing: 0.03em;
}
.bazi-archive-item-date {
  font-size: 0.68rem; color: var(--text-muted); margin-top: 1px;
}
.bazi-archive-item-actions { display: flex; gap: 6px; flex-shrink: 0; margin-left: 10px; }
.bazi-archive-btn-load, .bazi-archive-btn-note, .bazi-archive-btn-del {
  padding: 4px 10px; border-radius: 10px; border: 1px solid;
  font-size: 0.7rem; font-weight: 600; cursor: pointer; letter-spacing: 0.03em;
  transition: color 0.15s, background 0.15s, box-shadow 0.15s, border-color 0.15s; white-space: nowrap;
}
.bazi-archive-btn-load { background: rgba(93,138,124,0.1); color: #5D8A7C; border-color: rgba(93,138,124,0.4); }
.bazi-archive-btn-load:hover { background: #5D8A7C; color: #fff; }
.bazi-archive-btn-note { background: rgba(184,114,10,0.08); color: #B8720A; border-color: rgba(184,114,10,0.4); }
.bazi-archive-btn-note:hover { background: #D98A20; color: #fff; }
.bazi-archive-btn-del { background: rgba(196,30,10,0.06); color: #C41E0A; border-color: rgba(196,30,10,0.35); }
.bazi-archive-btn-del:hover { background: #C41E0A; color: #fff; }
.bazi-archive-actions-bar {
  display: flex; gap: 8px; margin-top: 12px; padding-top: 12px;
  border-top: 1px solid var(--border-light); flex-shrink: 0;
}
.bazi-archive-actions-bar button {
  flex: 1; padding: 8px 0; border-radius: 12px; border: 1.5px solid;
  font-family: var(--font-display); font-size: 0.8rem; font-weight: 600;
  cursor: pointer; letter-spacing: 0.04em;
  transition: color 0.2s, background 0.2s, box-shadow 0.2s, border-color 0.2s;
}
.bazi-archive-btn-close-panel { background: var(--bg-card); color: var(--text-secondary); border-color: var(--border-medium); }
.bazi-archive-btn-close-panel:hover { background: var(--border-light); }
.bazi-archive-btn-clear-all { background: rgba(196,30,10,0.06); color: #C41E0A; border-color: rgba(196,30,10,0.3); }
.bazi-archive-btn-clear-all:hover { background: rgba(196,30,10,0.12); }

/* ---- 打印样式 ---- */
@media print {
  body { background: #fff !important; }
  body::before { display: none; }
}
