        const NINE_STARS = {
            0: { name: '妖星', good: false, meaning: '上官嫁娶起造开店移徙入宅不利，主退败灾凶' },
            1: { name: '惑星', good: false, meaning: '主灾祸，不宜大事' },
            2: { name: '禾刀', good: false, meaning: '有灾迫，慎防口舌是非' },
            3: { name: '煞贡', good: true, meaning: '大吉，万事皆宜' },
            4: { name: '直星', good: true, meaning: '顺利，行事可心' },
            5: { name: '卜木', good: false, meaning: '凶恶，避讳重大决策' },
            6: { name: '角己', good: false, meaning: '凶恶，诸事不宜' },
            7: { name: '人专', good: true, meaning: '诸事清宁，万事和顺' },
            8: { name: '立早', good: false, meaning: '主凶，不宜行事' }
        };
        const GZ_60_ORDER = ['甲子','乙丑','丙寅','丁卯','戊辰','己巳','庚午','辛未','壬申','癸酉',
            '甲戌','乙亥','丙子','丁丑','戊寅','己卯','庚辰','辛巳','壬午','癸未',
            '甲申','乙酉','丙戌','丁亥','戊子','己丑','庚寅','辛卯','壬辰','癸巳',
            '甲午','乙未','丙申','丁酉','戊戌','己亥','庚子','辛丑','壬寅','癸卯',
            '甲辰','乙巳','丙午','丁未','戊申','己酉','庚戌','辛亥','壬子','癸丑',
            '甲寅','乙卯','丙辰','丁巳','戊午','己未','庚申','辛酉','壬戌','癸亥'];
        const NINE_STAR_ORDER = ['妖星','惑星','禾刀','煞贡','直星','卜木','角己','人专','立早'];

        function getSeasonType(month) {
            const m = Math.abs(month);
            if ([1, 4, 7, 10].includes(m)) return 'MENG';
            if ([2, 5, 8, 11].includes(m)) return 'ZHONG';
            if ([3, 6, 9, 12].includes(m)) return 'JI';
            return 'JI';
        }
        function getNineStar(gzDay, jqMonth) {
            if (!gzDay || gzDay.length < 2) return null;
            const startIndex = getSeasonType(jqMonth) === 'MENG' ? 0 : getSeasonType(jqMonth) === 'ZHONG' ? 1 : 2;
            const idx = GZ_60_ORDER.indexOf(gzDay);
            if (idx === -1) return null;
            const starIdx = (startIndex + idx) % 9;
            return { name: NINE_STAR_ORDER[starIdx], ...NINE_STARS[starIdx] };
        }
        // ═══════════════════════════════════════
        //  建除十二神常量
        //  黄道六星(红): 除危定执成开   黑道六星(黑): 建满平收破闭
        // ═══════════════════════════════════════
        const DUTY12_ORDER = ['建','除','滿','平','定','執','破','危','成','收','開','閉'];
        const DUTY12_GOOD = { '建':false,'除':true,'滿':false,'平':false,'定':true,'執':true,'破':false,'危':true,'成':true,'收':false,'開':true,'閉':false };
        const DUTY12_MEANING = {
            '建':'万物建始·宜求嗣出行', '除':'除旧布新·宜沐浴扫舍',
            '滿':'充盈饱满·宜祭祀祈福', '平':'平稳中和·宜修造动土',
            '定':'安定不移·宜嫁娶开市', '執':'执守不破·宜捕猎伐木',
            '破':'破败冲散·宜求医破屋', '危':'高危临险·宜祭祀安神',
            '成':'成就功业·宜嫁娶开市', '收':'收敛归藏·宜纳财入宅',
            '開':'开张通达·宜嫁娶出行', '閉':'闭塞不通·宜安葬修坟'
        };

        // ═══════════════════════════════════════
        //  无禄日判定 — "禄入旬空"
        //  日干禄位落入该日所属旬的旬空地支 → 无禄
        //  十日: 甲辰 乙巳 丙申 丁亥 戊戌 己丑 庚辰 辛巳 壬申 癸亥
        //  参考: 《协纪辨方书》卷八、《三命通会》
        // ═══════════════════════════════════════
        const LU_POS = { '甲':'寅','乙':'卯','丙':'巳','丁':'午','戊':'巳','己':'午','庚':'申','辛':'酉','壬':'亥','癸':'子' };
        function isWuluDay(dayStem, dayBranch) {
            const luBranch = LU_POS[dayStem];
            if (!luBranch || !dayBranch) return false;
            const xunKong = getXunKongBranches(dayStem, dayBranch);
            return xunKong.includes(luBranch);
        }
        const WULU_GZ = new Set(['甲辰','乙巳','丙申','丁亥','戊戌','己丑','庚辰','辛巳','壬申','癸亥']);

