        const SHICHEN_FULL = ['子时：23:00-00:59', '丑时：01:00-02:59', '寅时：03:00-04:59', '卯时：05:00-06:59', '辰时：07:00-08:59', '巳时：09:00-10:59', '午时：11:00-12:59', '未时：13:00-14:59', '申时：15:00-16:59', '酉时：17:00-18:59', '戌时：19:00-20:59', '亥时：21:00-22:59'];
        function getYearZodiac(y) { const i = y % 12; return { name: ZODIAC_ANIMALS[i], icon: ZODIAC_ICONS[i], full: ZODIAC_ANIMALS_CN[i] }; }

        // ═══════════════════════════════════════
        //  九星（金符经）– 自定义实现
        //  四孟甲子起妖星，仲冬甲子惑星临，
